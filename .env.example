# Google OAuth: создайте OAuth client в Google Cloud Console и подставьте значения.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
PLATFORM_CALLBACK_URL=http://localhost:8080/auth/callback

# Общий с ядром секрет для подписи входящих вебхуков.
LECTURELOG_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Локальный Postgres из docker-compose.yml.
PLATFORM_DB_DSN=postgres://lecturelog:lecturelog@localhost:5432/lecturelog?sslmode=disable

# === Разработка без реального ядра ===
# Ядро запускается отдельно. URL указывается без суффикса /api/v1.
CORE_API_BASE_URL=http://localhost:8000

# MinIO-заглушка из docker-compose.yml (запускается через make up-stub).
CORE_MINIO_ENDPOINT=localhost:9000
CORE_MINIO_ACCESS_KEY=lecturelog
CORE_MINIO_SECRET_KEY=lecturelog-minio-secret
CORE_MINIO_BUCKET=lecturelog
CORE_MINIO_USE_SSL=false

# === e2e/prod с реальным ядром ===
# Замените CORE_API_BASE_URL и CORE_MINIO_* на значения ядра и его Docker-портов.
# CORE_MINIO_ENDPOINT участвует в presigned URL, поэтому обязан быть доступен
# из браузера пользователя. Для web в production-контейнере доступ к ядру на
# хосте задаётся как host.docker.internal:<порт>; при этом endpoint presign для
# браузера обычно остаётся localhost:<порт> либо публичным адресом MinIO.
# Альтернатива — общая Docker-сеть web и ядра. LECTURELOG_WEBHOOK_SECRET общий с ядром.

# Необязательные параметры локального запуска.
PLATFORM_ADDR=:8080
PRESIGNED_TTL=24h
SESSION_TTL=720h
# Установите true только при HTTPS.
PLATFORM_SECURE=false
