# Docker image channel: dev, latest или конкретный релиз vX.Y.Z.
LECTURELOG_WEB_IMAGE_TAG=dev

# Локальный порт web на VPS. Наружу его должен публиковать reverse proxy.
WEB_HTTP_PORT=8080

# Пароль Postgres платформы. Сгенерируйте свой: openssl rand -hex 24
WEB_POSTGRES_PASSWORD=replace-with-random-password

# Google OAuth.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
PLATFORM_CALLBACK_URL=https://app.example.com/auth/callback

# Общий HMAC-секрет с lecturelog-core. Сгенерируйте один раз: openssl rand -hex 32
LECTURELOG_WEBHOOK_SECRET=replace-with-shared-random-secret

# CORE_API_BASE_URL в compose переопределяется на http://lecturelog-core-api:8000
# через общую Docker-сеть lecturelog-shared.

# MinIO ядра для чтения structure.json и presigned-ссылок медиа в браузере.
# Рекомендуется отдельный HTTPS-домен reverse proxy без path-prefix.
CORE_MINIO_ENDPOINT=files.example.com
CORE_MINIO_ACCESS_KEY=lecturelog
CORE_MINIO_SECRET_KEY=replace-with-the-same-value-as-core-s3-secret
CORE_MINIO_BUCKET=lectures
CORE_MINIO_USE_SSL=true

PRESIGNED_TTL=24h
SESSION_TTL=720h
PLATFORM_SECURE=true
PLATFORM_ADDR=:8080
