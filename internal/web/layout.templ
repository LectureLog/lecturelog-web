package web

import (
	"context"
	"fmt"

	"github.com/LectureLog/lecturelog-web/internal/auth"
)

// LayoutData — данные шапки и документа базового каркаса.
type LayoutData struct {
	// Title — заголовок вкладки браузера и название в шапке.
	Title string
	// CSRFToken — токен для htmx-мутаций (POST/DELETE через hx-headers).
	// Пустой токен → hx-headers="{}" (совместимость с существующими тестами).
	// Заполняется в main через csrf-инжектор (§7 плана).
	CSRFToken string
	// IsAuthed — признак аутентифицированного пользователя (навигация, выход).
	IsAuthed bool
	// IsAdmin — признак администратора для отображения ссылок админки.
	IsAdmin bool
	// SettingsAvailable — признак доступности settings-маршрутов в текущем сервере.
	SettingsAvailable bool
	// Active — ключ активного пункта навигации: hub|lectures|upload|"" (см. navLink).
	// Страницы выставляют его сами через withNav — обработчикам знать не нужно.
	Active string
}

// NewLayoutData собирает данные layout из контекста запроса.
func NewLayoutData(ctx context.Context, title string) LayoutData {
	return LayoutData{
		Title:             title,
		CSRFToken:         CSRFTokenFromContext(ctx),
		IsAuthed:          auth.UserFromContext(ctx) != nil,
		IsAdmin:           auth.IsAdminFromContext(ctx),
		SettingsAvailable: SettingsAvailableFromContext(ctx),
	}
}

// withNav возвращает копию LayoutData с активным пунктом навигации.
// Вызывается страницами при передаче данных в Layout: страница сама знает,
// какому пункту меню она соответствует.
func withNav(data LayoutData, active string) LayoutData {
	data.Active = active
	return data
}

// csrfHeaders формирует JSON-строку для hx-headers.
// Пустой токен → "{}" (обратная совместимость).
// Непустой токен → {"X-CSRF-Token":"<token>"}.
func csrfHeaders(token string) string {
	if token == "" {
		return "{}"
	}
	return fmt.Sprintf(`{"X-CSRF-Token":%q}`, token)
}

// docTitle формирует заголовок вкладки: «Страница · LectureLog».
// Для пустого заголовка — просто «LectureLog».
func docTitle(title string) string {
	if title == "" || title == "LectureLog" {
		return "LectureLog"
	}
	return title + " · LectureLog"
}

// Layout — базовый каркас «Читальный зал».
// actions — опциональный слот действий в правой части шапки (nil → только тумблер темы).
templ Layout(data LayoutData, actions templ.Component) {
	<!DOCTYPE html>
	<html lang="ru" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="LectureLog — конспекты лекций с тайм-кодами: загрузите запись, получите структурированный конспект со слайдами."/>
			<!-- Инлайн-скрипт темы: читает localStorage до first paint, устраняет FOUC -->
			<script>
				(function(){
					var t = localStorage.getItem('ll_theme');
					if (t === 'dark' || t === 'light') {
						document.documentElement.setAttribute('data-theme', t);
					}
				})();
			</script>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<!-- Google Fonts: Source Serif 4 (контент) + Onest (интерфейс) -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,500;1,8..60,600&family=Onest:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/vendor/htmx.min.js" defer></script>
			<title>{ docTitle(data.Title) }</title>
		</head>
		<!-- hx-headers: пустой токен → {}; с токеном → {"X-CSRF-Token":"..."} -->
		<body hx-headers={ csrfHeaders(data.CSRFToken) }>
			@header(data, actions)
			<main class="ll-main">
				{ children... }
			</main>
			@footer()
		</body>
	</html>
}

// header — sticky-шапка 58px: бренд + навигация слева, actions+сервис справа.
templ header(data LayoutData, actions templ.Component) {
	<header class="ll-topbar">
		<div class="ll-topbar-inner">
			<a class="ll-brand" href="/" aria-label="LectureLog — на главную">
				@brandMark()
				<span class="ll-brand-t">LectureLog</span>
			</a>
			@topNav(data)
			<div class="ll-top-actions">
				if actions != nil {
					@actions
				}
				if !data.IsAuthed {
					<a href="/auth/login" class="ll-btn ll-btn--login">Войти</a>
				}
				if data.IsAdmin && data.SettingsAvailable {
					@adminGearLink()
				}
				@themeToggle()
				if data.IsAuthed {
					@logoutButton(data.CSRFToken)
				}
			</div>
		</div>
	</header>
}

// topNav — основная навигация в шапке. Пункты «Мои лекции» и «Загрузить»
// видны только аутентифицированным пользователям.
templ topNav(data LayoutData) {
	<nav class="ll-nav" aria-label="Основная навигация">
		@navLink("/hub", "Витрина", data.Active == "hub")
		if data.IsAuthed {
			@navLink("/lectures", "Мои лекции", data.Active == "lectures")
			@navLink("/upload", "Загрузить", data.Active == "upload")
		}
	</nav>
}

// navLink — пункт навигации с подчёркиванием активного состояния.
templ navLink(href, label string, active bool) {
	if active {
		<a class="ll-nav-link ll-nav-link--active" href={ href } aria-current="page">{ label }</a>
	} else {
		<a class="ll-nav-link" href={ href }>{ label }</a>
	}
}

// themeToggle — кнопка переключения светлой/тёмной темы.
templ themeToggle() {
	<button
		class="ll-icon-btn"
		aria-label="Сменить тему"
		onclick="(function(btn){var root=document.documentElement;var t=root.getAttribute('data-theme')==='dark'?'light':'dark';root.setAttribute('data-theme',t);localStorage.setItem('ll_theme',t);})(this)"
	>
		<!-- Иконка луны (светлая тема активна) -->
		@iconMoon()
		<!-- Иконка солнца (тёмная тема активна) -->
		@iconSun()
	</button>
}

// adminGearLink — вход в админские настройки.
templ adminGearLink() {
	<a class="ll-icon-btn" href="/settings" aria-label="Настройки" title="Настройки">
		@iconSettings()
	</a>
}

// logoutButton — выход из аккаунта: обычная форма POST /auth/logout.
// CSRF передаётся скрытым полем gorilla.csrf.Token (стандартное имя gorilla/csrf) —
// без htmx, чтобы браузер честно ушёл по редиректу сервера.
templ logoutButton(csrfToken string) {
	<form class="ll-logout-form" method="post" action="/auth/logout">
		<input type="hidden" name="gorilla.csrf.Token" value={ csrfToken }/>
		<button class="ll-icon-btn" type="submit" aria-label="Выйти" title="Выйти">
			@iconLogout()
		</button>
	</form>
}

// footer — нижний колонтитул: марка, слоган, ссылки на проект, тонкая линия сверху.
templ footer() {
	<footer class="ll-footer">
		<div class="ll-footer-inner">
			<div class="ll-footer-brand">
				@brandMark()
				<span>LectureLog</span>
			</div>
			<p class="ll-footer-tag">Конспекты лекций с тайм-кодами — загрузите запись, читайте конспект.</p>
			<nav class="ll-footer-links" aria-label="Ссылки проекта">
				<a class="ll-footer-link" href="/hub">Витрина</a>
				@footerExtLink(repoCoreURL, "lecturelog-core", false) {
					@iconGithub()
				}
				@footerExtLink(repoWebURL, "lecturelog-web", false) {
					@iconGithub()
				}
				@footerExtLink(devTelegramURL, "Telegram разработчика — @fus1ond", true) {
					@iconTelegram()
				}
			</nav>
		</div>
	</footer>
}

// footerExtLink — внешняя ссылка футера; иконка передаётся дочерним блоком.
// Единственная точка задания target/rel: без noopener новая вкладка получает
// доступ к window.opener, поэтому rel задаётся здесь, а не на местах вызова.
// href передаётся выражением, а не литералом — так templ прогоняет его через
// SafeURL-санитайзер и посторонние схемы становятся about:invalid.
//
// label — доступное имя ссылки. При iconOnly=true подпись не рисуется, и имя
// остаётся только в aria-label: сама иконка помечена aria-hidden, поэтому без
// aria-label скринридер прочитал бы лишь URL.
templ footerExtLink(href string, label string, iconOnly bool) {
	<a
		class={ "ll-footer-link", "ll-footer-link--ext", templ.KV("ll-footer-link--icon", iconOnly) }
		href={ href }
		target="_blank"
		rel="noopener noreferrer"
		aria-label={ label }
	>
		{ children... }
		if !iconOnly {
			<span>{ label }</span>
		}
	</a>
}

// brandMark — логотип-квадрат 24px цвета --accent с иконкой книги.
templ brandMark() {
	<span class="ll-brand-mark">
		@iconBook()
	</span>
}

// iconLogout — иконка выхода (дверь со стрелкой).
templ iconLogout() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
		<path d="M16 17l5-5-5-5"></path>
		<path d="M21 12H9"></path>
	</svg>
}
